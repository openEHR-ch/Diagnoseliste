definition
	EVALUATION[at0000] matches {    -- Problem list item
		data matches {
			ITEM_TREE[at0001] matches {    -- Item tree
				items cardinality matches {0..*; unordered} matches {
					ELEMENT[at0002] matches {    -- EHR URI of diagnosis
						value matches {
							DV_EHR_URI matches {*}
						}
					}
					ELEMENT[at0006] occurrences matches {0..1} matches {    -- Rank
						value matches {
							DV_COUNT matches {
								magnitude matches {|>=1|}
							}
						}
					}
					ELEMENT[at0007] occurrences matches {0..1} matches {    -- Priority
						value matches {
							1|[local::at0008],
							2|[local::at0009],
							3|[local::at0010]
						}
					}
					allow_archetype CLUSTER[at0003] occurrences matches {0..*} matches {    -- Status
						include
							archetype_id/value matches {/.*|openEHR-EHR-CLUSTER\.problem_qualifier(-[a-zA-Z0-9_]+)*\.v2/}
					}
					ELEMENT[at0005] occurrences matches {0..1} matches {    -- Comment
						value matches {
							DV_TEXT matches {*}
						}
					}
				}
			}
		}
		protocol matches {
			ITEM_TREE[at0004] matches {*}    -- Item tree
		}
	}

